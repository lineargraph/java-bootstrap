<?xml version="1.0" encoding="UTF-8"?>
<project name="eclipse" default="build">

    <property name="base"          value="./"/>
    <property name="dest"          value="build/"/>
    <property name="work"          value="${dest}classes/"/>
    <property name="build.lib"     value="${dest}lib/"/>
    <property name="encoding"      value="UTF-8"/>
    <property name="mainclass"     value="org.eclipse.jdt.internal.compiler.batch.Main"/>
    <property name="source"        value="${jVersion}"/>
    <property name="target"        value="${jVersion}"/>
    <path id="classpath">
        <fileset dir="${build.lib}" includes="*.jar"/>
    </path>

    <target name="prepare">
        <mkdir dir="${dest}"/>
        <mkdir dir="${work}"/>
        <mkdir dir="${build.lib}"/>
    </target>